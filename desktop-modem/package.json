{
  "name": "bnycrm-modem",
  "version": "1.0.0",
  "private": true,
  "description": "Portable Windows CRM with USB modem and native audio",
  "author": "BNY CRM",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "prepare:worker": "node build-worker.cjs",
    "build:pbx": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File build-pbx.ps1",
    "start": "npm run prepare:worker && electron .",
    "dist": "npm run prepare:worker && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.bnycrm.desktop",
    "productName": "BNY CRM",
    "publish": [
      {
        "provider": "github",
        "owner": "DineshMurugan2022",
        "repo": "projectcrm"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "pbx.html",
      "pbx-renderer.js",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "bundle",
        "to": "worker"
      },
      {
        "from": "bundle/node_modules",
        "to": "worker/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "native",
        "to": "pbx",
        "filter": [
          "bny-pbx-engine.exe",
          "*.dll",
          "PJSIP-LICENSE.txt",
          "PJSIP-2.17-source.zip"
        ]
      },
      {
        "from": "pbx-engine",
        "to": "pbx-source",
        "filter": [
          "pbx-engine.cpp",
          "CMakeLists.txt",
          "local-smoke.cjs",
          "LICENSE.txt"
        ]
      },
      {
        "from": "build-pbx.ps1",
        "to": "pbx-source/build-pbx.ps1"
      }
    ],
    "npmRebuild": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BNY-CRM-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "BNY CRM",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "afterPack": "./verify-package.cjs"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
